# nuBuilder Next – browser cache for the static files (0.8.366, Lighthouse "Use efficient cache lifetimes").
# Pages load every file of assets/ through nu_asset(): the URL carries ?v=<file time>, so a changed file gets a new URL and a long
# cache is safe – one year, "immutable" (no revalidation on reload). Files without ?v= (fonts and images that a stylesheet loads):
# one week. Every block only runs when its module is there – without mod_headers / mod_expires nothing changes.
# nginx ignores this file: see Help → Security → Web server rules.

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
	<IfModule mod_version.c>
		<IfVersion >= 2.4>
			<If "%{QUERY_STRING} =~ /(^|&)v=/">
				Header set Cache-Control "public, max-age=31536000, immutable"
				Header unset Expires
			</If>
		</IfVersion>
	</IfModule>
</IfModule>

# Compression (0.8.765, review B3): CSS / JavaScript / SVG / JSON go out gzip-compressed – Bootstrap, the form runtime and CodeMirror
# shrink to about a fifth. Needs the same "AllowOverride FileInfo" as the Header rules above; without mod_deflate nothing changes.
<IfModule mod_deflate.c>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE text/css application/javascript text/javascript application/json image/svg+xml text/plain
	</IfModule>
</IfModule>
