						{
							"id": "cus_since",
							"type": "input",
							"label": "Customer since",
							"input": "nuDate",
							"format": "D|dd.mm.yyyy",
							"top": 20,
							"left": 170,
							"width": 110,
							"height": 22
						},
						{
							"id": "cus_credit",
							"type": "input",
							"label": "Credit limit",
							"input": "nuNumber",
							"format": "N|USD 1,000.00",
