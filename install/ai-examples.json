{
	"comment": "Example forms of the AI context pack (core/nuaicontext.php) – the sample application's customers form and orders form with its sub-form, exported with NuFormSpec::fromForm. Regenerate when the format changes.",
	"forms": [
		{
			"format": "nunext-form-1",
			"form": {
				"code": "sample_customer",
				"description": "Sample: customers",
				"type": "browseedit",
				"table": "sample_customer",
				"primary_key": "sample_customer_id",
				"browse_sql": "SELECT * FROM sample_customer",
				"rows_per_page": 10,
				"browse": [
					{
						"title": "Code",
						"field": "cus_code",
						"width": 90,
						"align": "left"
					},
					{
						"title": "Name",
