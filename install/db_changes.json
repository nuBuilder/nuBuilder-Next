{
    "format": 1,
    "version": "0.8.647",
    "steps": [
        {
            "id": "0001-own-tables",
            "description": "nuBuilder Next tables: log, form history, 2FA, tokens, sessions, API, dashboards …",
            "changes": [
                {
                    "table": "zzzzsys_nunext_*",
                    "kind": "table",
                    "what": "nuBuilder Next tables created when missing (log, form history, 2FA, tokens, sessions, settings, API, dashboards …)"
                }
            ]
        },
        {
            "id": "0002-report-tables",
            "description": "nuBuilder Forte report and SQL builder tables (zzzzsys_report, zzzzsys_access_report, zzzzsys_select, zzzzsys_select_clause) when missing",
            "changes": [
                {
                    "table": "zzzzsys_report",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_access_report",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_select",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_select_clause",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0003-translate-table",
            "description": "nuBuilder Forte translation table (zzzzsys_translate) when missing – new installations have it, older ones got it only with the first saved translation",
            "changes": [
                {
                    "table": "zzzzsys_translate",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0004-cloner-tables",
            "description": "nuBuilder Forte tables of saved Cloner and App cloner settings (zzzzsys_cloner, zzzzsys_app_cloner) when missing",
            "changes": [
                {
                    "table": "zzzzsys_cloner",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_app_cloner",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0005-setting-primary-db",
            "description": "Settings table: row $nuConfigPrimaryDatabaseManagement (phpMyAdmin or Adminer) when missing",
            "changes": [
                {
                    "table": "zzzzsys_config",
                    "kind": "data",
                    "what": "row $nuConfigPrimaryDatabaseManagement added when missing"
                }
            ]
        },
        {
            "id": "0007-drop-vendor-layout",
            "description": "Settings of nuBuilder Next: row vendor_layout of the former Admin tools view removed",
            "changes": [
                {
                    "table": "zzzzsys_nunext_setting",
                    "kind": "data",
                    "what": "row vendor_layout deleted"
                }
            ]
        },
        {
            "id": "0008-admin-roles",
            "description": "nuBuilder Next admin roles (zzzzsys_nunext_admin_role, zzzzsys_nunext_admin_user) with the five default roles",
            "changes": [
                {
                    "table": "zzzzsys_nunext_admin_role",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_admin_user",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_admin_role",
                    "kind": "data",
                    "what": "five default roles inserted when the table is empty"
                }
            ]
        },
        {
            "id": "0009-list-views",
            "description": "nuBuilder Next list views (zzzzsys_nunext_list_view): layouts of the users and access level lists",
            "changes": [
                {
                    "table": "zzzzsys_nunext_list_view",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0010-home-layouts",
            "description": "Start page: the layout becomes the shared layout \"Standard\" (saved layouts, zzzzsys_nunext_list_view)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_list_view",
                    "kind": "data",
                    "what": "the start page layout inserted as shared layout \"Standard\" (list_key home) and set as default"
                },
                {
                    "table": "zzzzsys_nunext_setting",
                    "kind": "data",
                    "what": "row home_layout moved there and deleted"
                }
            ]
        },
        {
            "id": "0011-audit",
            "description": "Audit trail (zzzzsys_nunext_audit): table created, the record changes of the log copied into it",
            "changes": [
                {
                    "table": "zzzzsys_nunext_audit",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_audit",
                    "kind": "data",
                    "what": "record changes of zzzzsys_nunext_log (record_inserted, record_updated, record_deleted) copied, one row per column"
                }
            ]
        },
        {
            "id": "0012-notifications",
            "description": "Notification centre (zzzzsys_nunext_notification, zzzzsys_nunext_notification_user); permission items NUNEXT_NOTIFY and NUNEXT_NOTIFY_OWN",
            "changes": [
                {
                    "table": "zzzzsys_nunext_notification",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_notification_user",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_permission_item",
                    "kind": "data",
                    "what": "items NUNEXT_NOTIFY and NUNEXT_NOTIFY_OWN added when missing (group \"nuBuilder Next\")"
                }
            ]
        },
        {
            "id": "0013-setting-home-hooks",
            "description": "Settings table: row $nuConfigHomeHooks (start page hooks on / off) when missing",
            "changes": [
                {
                    "table": "zzzzsys_config",
                    "kind": "data",
                    "what": "row $nuConfigHomeHooks added when missing"
                }
            ]
        },
        {
            "id": "0014-database-origin",
            "description": "Settings of nuBuilder Next: row db_origin (new database, existing nuBuilder Forte database, or installed before 0.8.380)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_setting",
                    "kind": "data",
                    "what": "row db_origin added when missing"
                }
            ]
        },
        {
            "id": "0015-form-drafts",
            "description": "Form drafts (zzzzsys_nunext_form_draft)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_form_draft",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0016-pages",
            "description": "Page forms (zzzzsys_nunext_page)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_page",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0017-presence",
            "description": "Who has a record open (zzzzsys_nunext_presence)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_presence",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0018-home-hook-codes",
            "description": "Start page hooks renamed: procedures nunext_home → nu_home, nunext_home_user → nu_home_user",
            "changes": [
                {
                    "table": "zzzzsys_php",
                    "kind": "data",
                    "what": "sph_code nunext_home → nu_home and nunext_home_user → nu_home_user (only when the new code is not taken)"
                },
                {
                    "table": "zzzzsys_config",
                    "kind": "data",
                    "what": "description of the row $nuConfigHomeHooks names nu_home"
                }
            ]
        },
        {
            "id": "0019-user-fields",
            "description": "Custom user fields (zzzzsys_nunext_user_field); their values table is created with the first field",
            "changes": [
                {
                    "table": "zzzzsys_nunext_user_field",
                    "kind": "table",
                    "what": "created when missing (zzzzsys_nunext_user_ext follows when the first field is added)"
                }
            ]
        },
        {
            "id": "0020-upload-template",
            "description": "Uppy uploads: nuBuilder Forte's procedure nu_upload_file_template (hardened) and the snippet nu_upload_file_uppy_code_template when missing",
            "changes": [
                {
                    "table": "zzzzsys_php",
                    "kind": "data",
                    "what": "procedure nu_upload_file_template added when no procedure has that code"
                },
                {
                    "table": "zzzzsys_code_snippet",
                    "kind": "data",
                    "what": "snippet nu_upload_file_uppy_code_template (Uppy HTML of file objects) added when missing"
                }
            ]
        },
        {
            "id": "0021-recent",
            "description": "Side bar: recently used pages and forms per user (zzzzsys_nunext_recent)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_recent",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0022-upload-template-folder",
            "description": "Upload procedure nu_upload_file_template: files no longer in the web root (only an unchanged copy of the earlier template is replaced)",
            "changes": [
                {
                    "table": "zzzzsys_php",
                    "kind": "data",
                    "what": "nu_upload_file_template replaced when it is an unchanged earlier template"
                }
            ]
        },
        {
            "id": "0023-retire-tfm",
            "description": "Tiny File Manager removed (File Manager = the page nuFiles): its library packs and the copy in third_party/tinyfilemanager/",
            "changes": [
                {
                    "table": "zzzzsys_nunext_log",
                    "kind": "data",
                    "what": "files only: Tiny File Manager packs (vendor/packs/tinyfilemanager-*, third_party/tinyfilemanager*) deleted, logged"
                }
            ]
        },
        {
            "id": "0024-object-access",
            "description": "Field data access: rules per object (zzzzsys_nunext_object_access)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_object_access",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0025-user-access",
            "description": "Additional access levels per user (zzzzsys_nunext_user_access)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_user_access",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0026-user-home",
            "description": "nuBuilder Forte's User Home (launch form nuuserhome with the tabs Main and Fast Forms) when missing",
            "changes": [
                {
                    "table": "zzzzsys_form",
                    "kind": "data",
                    "what": "form nuuserhome (User Home) added when missing – also checked with every later update"
                },
                {
                    "table": "zzzzsys_tab",
                    "kind": "data",
                    "what": "its tabs Main and Fast Forms"
                }
            ]
        },
        {
            "id": "0027-themes",
            "description": "Themes (zzzzsys_nunext_theme); an accent colour of Branding becomes the own theme \"My theme\", used by everyone",
            "changes": [
                {
                    "table": "zzzzsys_nunext_theme",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_setting",
                    "kind": "data",
                    "what": "Branding's accent colour (if set) moved into the own theme \"My theme\" (row theme)"
                }
            ]
        }
    ],
