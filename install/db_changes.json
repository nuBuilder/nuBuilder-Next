{
    "format": 1,
    "version": "0.8.382",
    "steps": [
        {
            "id": "0001-own-tables",
            "description": "nuBuilder Next tables: log, form history, 2FA, tokens, sessions, API, dashboards …",
            "changes": [
                {
                    "table": "zzzzsys_nunext_*",
                    "kind": "table",
                    "what": "nuBuilder Next tables created when missing (log, form history, 2FA, tokens, sessions, settings, API, dashboards …)"
                }
            ]
        },
        {
            "id": "0002-report-tables",
            "description": "nuBuilder report and SQL builder tables (zzzzsys_report, zzzzsys_access_report, zzzzsys_select, zzzzsys_select_clause) when missing",
            "changes": [
                {
                    "table": "zzzzsys_report",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_access_report",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_select",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_select_clause",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0003-translate-table",
            "description": "nuBuilder translation table (zzzzsys_translate) when missing – new installations have it, older ones got it only with the first saved translation",
            "changes": [
                {
                    "table": "zzzzsys_translate",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0004-cloner-tables",
            "description": "nuBuilder tables of saved Cloner and App cloner settings (zzzzsys_cloner, zzzzsys_app_cloner) when missing",
            "changes": [
                {
                    "table": "zzzzsys_cloner",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_app_cloner",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0005-setting-primary-db",
            "description": "Settings table: row $nuConfigPrimaryDatabaseManagement (phpMyAdmin or Adminer) when missing",
            "changes": [
                {
                    "table": "zzzzsys_config",
                    "kind": "data",
                    "what": "row $nuConfigPrimaryDatabaseManagement added when missing"
                }
            ]
        },
        {
            "id": "0007-drop-vendor-layout",
            "description": "Settings of nuBuilder Next: row vendor_layout of the former Admin tools view removed",
            "changes": [
                {
                    "table": "zzzzsys_nunext_setting",
                    "kind": "data",
                    "what": "row vendor_layout deleted"
                }
            ]
        },
        {
            "id": "0008-admin-roles",
            "description": "nuBuilder Next admin roles (zzzzsys_nunext_admin_role, zzzzsys_nunext_admin_user) with the five default roles",
            "changes": [
                {
                    "table": "zzzzsys_nunext_admin_role",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_admin_user",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_admin_role",
                    "kind": "data",
                    "what": "five default roles inserted when the table is empty"
                }
            ]
        },
        {
            "id": "0009-list-views",
            "description": "nuBuilder Next list views (zzzzsys_nunext_list_view): layouts of the users and access level lists",
            "changes": [
                {
                    "table": "zzzzsys_nunext_list_view",
                    "kind": "table",
                    "what": "created when missing"
                }
            ]
        },
        {
            "id": "0010-home-layouts",
            "description": "Start page: the layout becomes the shared layout \"Standard\" (saved layouts, zzzzsys_nunext_list_view)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_list_view",
                    "kind": "data",
                    "what": "the start page layout inserted as shared layout \"Standard\" (list_key home) and set as default"
                },
                {
                    "table": "zzzzsys_nunext_setting",
                    "kind": "data",
                    "what": "row home_layout moved there and deleted"
                }
            ]
        },
        {
            "id": "0011-audit",
            "description": "Audit trail (zzzzsys_nunext_audit): table created, the record changes of the log copied into it",
            "changes": [
                {
                    "table": "zzzzsys_nunext_audit",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_audit",
                    "kind": "data",
                    "what": "record changes of zzzzsys_nunext_log (record_inserted, record_updated, record_deleted) copied, one row per column"
                }
            ]
        },
        {
            "id": "0012-notifications",
            "description": "Notification centre (zzzzsys_nunext_notification, zzzzsys_nunext_notification_user); permission items NUNEXT_NOTIFY and NUNEXT_NOTIFY_OWN",
            "changes": [
                {
                    "table": "zzzzsys_nunext_notification",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_nunext_notification_user",
                    "kind": "table",
                    "what": "created when missing"
                },
                {
                    "table": "zzzzsys_permission_item",
                    "kind": "data",
                    "what": "items NUNEXT_NOTIFY and NUNEXT_NOTIFY_OWN added when missing (group \"nuBuilder Next\")"
                }
            ]
        },
        {
            "id": "0013-setting-home-hooks",
            "description": "Settings table: row $nuConfigHomeHooks (start page hooks on / off) when missing",
            "changes": [
                {
                    "table": "zzzzsys_config",
                    "kind": "data",
                    "what": "row $nuConfigHomeHooks added when missing"
                }
            ]
        },
        {
            "id": "0014-database-origin",
            "description": "Settings of nuBuilder Next: row db_origin (new database, existing nuBuilder database, or installed before 0.8.380)",
            "changes": [
                {
                    "table": "zzzzsys_nunext_setting",
                    "kind": "data",
                    "what": "row db_origin added when missing"
                }
            ]
        }
    ],
