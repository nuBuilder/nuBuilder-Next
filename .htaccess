# nuBuilder Next – package files that are never served directly (Apache). The folders core/, pages/, lang/, install/, docs/,
# dev/, _backup/, _install/ and temp/ have their own .htaccess. nginx ignores these files: see Help → Security for its rules.
<FilesMatch "^(README\.md|TODO\.md|CLAUDE\.md|nunext-manifest\.json|nuconfig\.php|nuconfig-sample\.php|install\.allow|cron\.php|\.gitignore|NUNEXT-VERSION\.txt)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
