# nuBuilder Next – package files that are never served directly (Apache). The folders core/, pages/, lang/, install/, docs/,
# dev/, _backup/, _install/ and temp/ have their own .htaccess. nginx ignores these files: see Help → Security for its rules.
<FilesMatch "^(README\.md|CHANGELOG\.md|LICENSE|TODO\.md|CLAUDE\.md|nunext-manifest\.json|nuconfig\.php|nuconfig-sample\.php|install\.allow|cron\.php|\.gitignore|NUNEXT-VERSION\.txt)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# No folder listings (0.8.478, security assessment K5): with Apache's autoindex on, folders without index file (vendor/bundled/,
# _install/ …) would list their files. IndexIgnore needs the same "AllowOverride Indexes" as the cache rules in assets/.htaccess
# (Options -Indexes would need "AllowOverride Options", which some hosts refuse with an error 500). nginx lists nothing by default.
<IfModule mod_autoindex.c>
	IndexIgnore *
</IfModule>
